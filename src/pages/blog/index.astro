---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/Blog/PostCard.astro";
import PostsContainer from "@/components/Blog/PostsContainer.astro";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );
---

<Layout
  seo={{
    title: "Blog",
    description: "My personal blog",
  }}
>
  <div class="flex flex-col gap-10 py-12">
    <div class="flex flex-col gap-3">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">Latest Articles</h1>
      <p class="text-neutral-600 dark:text-neutral-400">Some of my recent thoughts on web development, tools, and the tech industry.</p>
    </div>
    <PostsContainer>
      {posts.map((post) => <PostCard post={post} />)}
    </PostsContainer>
  </div>
</Layout>
