---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/Blog/Prose.astro";
import { formatDate } from "@/utils";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  const paths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const post = entry.data
---

<Layout
  seo={{
    title: post.title,
    description: post.description,
    openGraph: {
      basic: {
        title: post.title,
        type: "article",
        image: post.cover?.src || "",
      },
    },
  }}
>
  <article class="py-12 max-w-3xl mx-auto">
    <a href="/blog" class="inline-flex items-center gap-1 text-sm font-medium text-neutral-900 dark:text-neutral-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors mb-10">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      Blog
    </a>
    <header class="flex flex-col items-center text-center gap-4 mb-8">
      <span class="text-sm text-neutral-500">{formatDate(post.publishedAt)}</span>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">{post.title}</h1>
    </header>
    {
      post.cover?.src && (
        <Image
          src={post.cover}
          alt={post.title}
          width={800}
          height={450}
          class="w-full rounded-xl mb-12"
        />
      )
    }
    <Prose>
      <Content />
    </Prose>
  </article>
</Layout>
