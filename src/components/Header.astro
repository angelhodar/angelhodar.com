---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<div class="fixed top-4 left-1/2 -translate-x-1/2 z-50">
  <nav class="flex items-center gap-1 px-2 py-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md shadow-sm">
    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition-colors",
            isActive(href)
              ? "text-neutral-900 dark:text-neutral-100 font-semibold"
              : "text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100",
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="md:hidden p-2 rounded-full text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      aria-label="Open menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <button
      id="theme-toggle-button"
      type="button"
      class="p-2 rounded-full text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      aria-label="Toggle between Dark and Light mode"
      data-toggle-color-scheme
    >
      <Icon name="sun" class="w-5 h-5" />
    </button>
  </nav>
</div>

<!-- Mobile menu dropdown -->
<div id="mobile-menu" class="hidden fixed top-16 left-1/2 -translate-x-1/2 z-50 md:hidden">
  <div class="flex flex-col gap-1 px-3 py-3 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-lg">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          "px-4 py-2 rounded-full text-sm font-medium transition-colors",
          isActive(href)
            ? "text-neutral-900 dark:text-neutral-100 font-semibold"
            : "text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100",
        ]}
      >
        {label}
      </a>
    ))}
  </div>
</div>

<!-- Spacer to prevent content from hiding behind fixed nav -->
<div class="h-16"></div>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (btn && menu) {
      btn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
      });
    }
  }
  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
