---
import Card from "@/components/Card.astro"

const { name } = Astro.props;
---

<Card class="gap-4">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-500">{name}</h3>
    <div class="flex flex-wrap justify-center md:justify-start items-center gap-6"><slot /></div>
</Card>
