---
const { title, href, location, startDate, endDate } = Astro.props;
---

<div class="flex flex-col gap-1 border-l-2 border-neutral-300 dark:border-neutral-700 pl-5 py-1">
    <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">{title}</h3>
    <a href={href} target="_blank" rel="noopener noreferrer" class="text-sm text-primary-600 dark:text-primary-400 hover:underline w-fit">
        {location}
    </a>
    <span class="text-sm text-neutral-500">{startDate} — {endDate}</span>
</div>
