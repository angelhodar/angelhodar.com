---
import { Icon } from "astro-icon/components";
---

<footer class="mt-auto border-t border-neutral-200 dark:border-neutral-800 py-8">
  <div class="flex flex-col items-center gap-4">
    <div class="flex items-center gap-5">
      <a
        href="mailto:angelhodar76@gmail.com"
        aria-label="Email"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        <Icon name="logos:google-gmail" class="w-7 h-7" />
      </a>
      <a
        href="https://github.com/angelhodar"
        target="_blank"
        aria-label="GitHub"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        <Icon name="devicon:github" class="w-7 h-7 dark:bg-white dark:rounded" />
      </a>
      <a
        href="https://www.linkedin.com/in/angel-rodriguez-hodar-541bb8199/"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        <Icon name="devicon:linkedin" class="w-7 h-7" />
      </a>
      <a
        href="https://twitter.com/angelhodar"
        target="_blank"
        aria-label="Twitter"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        <Icon name="logos:twitter" class="w-7 h-7" />
      </a>
    </div>
    <p class="text-sm text-neutral-500">
      &copy; {new Date().getFullYear()} Angel Hodar
    </p>
  </div>
</footer>
